{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "dist/esm",
    "tsBuildInfoFile": ".cache/tsc/tsconfig.build.esm.tsbuildinfo",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
